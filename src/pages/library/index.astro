---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const subjects = (await getCollection(
  'librarySubjects',
  ({ data }) => !data.draft
)).sort((a, b) => a.data.order - b.data.order);

const guides = await getCollection('guides', ({ data }) => !data.draft);

const shelves = subjects
  .map((subject) => {
    const pieceCount = guides.filter(
      (guide) => guide.data.subject === subject.id
    ).length;

    return {
      id: subject.id,
      title: subject.data.title,
      pieceCount
    };
  })
  .filter((shelf) => shelf.pieceCount > 0);
---

<BaseLayout
  title="Library — Desmond Khoo"
  description="Subjects I have spent enough time understanding to explain clearly. Not everything I have read. Only what I think is worth keeping."
>
  <main>
    <section class="page-hero library-hero">
      <div class="shell">
        <p class="eyebrow">What I have learned</p>
        <h1>Library.</h1>
        <p class="lede">
          Subjects I have spent enough time understanding to explain clearly.
          Not everything I have read. Only what I think is worth keeping.
        </p>
      </div>
    </section>

    <section class="section library-catalogue-section">
      <div class="shell">
        <p class="eyebrow library-catalogue-heading">Browse the shelves</p>

        {shelves.length ? (
          <nav class="library-catalogue" aria-label="Library subjects">
            {shelves.map((shelf, index) => (
              <a
                class="library-subject-row"
                href={`/library/${shelf.id}/`}
              >
                <span class="library-subject-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <span class="library-subject-name">
                  {shelf.title}
                </span>

                <span class="library-subject-count">
                  {String(shelf.pieceCount).padStart(2, '0')}
                  {' '}
                  {shelf.pieceCount === 1 ? 'piece' : 'pieces'}
                </span>

                <span class="library-subject-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))}
          </nav>
        ) : (
          <div class="empty-state">
            No Library subjects are published yet.
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>