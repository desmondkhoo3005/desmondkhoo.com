---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <main>
    <section class="shell hero">
      <p class="eyebrow">An independent archive of better judgment</p>
      <h1>Think better.<br /><em class="gold">Live better.</em></h1>
      <p class="hero-note">Everything here began as a decision I had to make myself.</p>
      <a class="scroll-mark" href="#mission" aria-label="Continue">↓</a>
    </section>

    <section id="mission" class="section mission">
      <div class="shell section-grid">
        <p class="eyebrow">Mission</p>
        <h2 class="section-title">Helping people<br />and organisations<br /><em>make better decisions.</em></h2>
      </div>
    </section>

    <section class="section">
      <div class="shell">
        <div class="archive-intro">
          <div>
            <p class="eyebrow">Archive</p>
            <h2>Three ways of making<br />judgment visible.</h2>
          </div>
        </div>
        <div class="archive-grid">
          <a class="archive-card" href="/decisions/">
            <p class="eyebrow">What I chose</p>
            <h3>Decisions</h3>
            <p>Real choices, their context, the trade-offs, my judgment and what could change my mind.</p>
            <span class="arrow">Explore decisions ↗</span>
          </a>
          <a class="archive-card" href="/positions/">
            <p class="eyebrow">What I believe</p>
            <h3>Positions</h3>
            <p>Arguments about work, money, society and life—with counterarguments and uncertainty left visible.</p>
            <span class="arrow">Explore positions ↗</span>
          </a>
          <a class="archive-card" href="/library/">
            <p class="eyebrow">What I have learned</p>
            <h3>Library</h3>
            <p>Structured guides to finance, F.I.R.E., DeFi, blockchain, risk and other subjects worth understanding.</p>
            <span class="arrow">Enter the library ↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="shell about-grid">
        <h2>I do the homework other people don’t have time to do.</h2>
        <div class="about-copy">
          <p>Finance professional, strategist, obsessive researcher, amateur golfer, husband and father in Singapore.</p>
          <p>I write about decisions I am genuinely making—not topics selected by an algorithm.</p>
          <a class="text-link" href="/contact/">Say Hi ↗</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
